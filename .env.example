# Token del bot, se obtiene hablando con @BotFather en Telegram
TELEGRAM_TOKEN=
# API key de Claude (https://platform.claude.com). Sin ella el bot hace búsqueda directa, sin IA.
ANTHROPIC_API_KEY=
# De dónde sale el stock: la URL de la web app de apps_script/ExportarStock.gs (con el token),
# o un archivo .csv / .json local. Por defecto: data/stock.csv
VOLHOTIC_FUENTE=https://script.google.com/macros/s/XXXX/exec?token=XXXX
# Cada cuántos minutos se vuelve a leer la planilla (0 = solo al arrancar)
VOLHOTIC_REFRESCO_MIN=10
# interno = muestra depósito, ubicación y observaciones | cliente = las oculta
VOLHOTIC_MODO=interno
# Opcional
# VOLHOTIC_MODELO=claude-opus-5-5
